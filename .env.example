# ---------------------------------------------------------------
# Frontend (.env.local at the repo root)
# ---------------------------------------------------------------

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL="http://localhost:8000"


# ---------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostelhub"

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY="change-me"

# JWT signing algorithm.
ALGORITHM="HS256"

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES="30"

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,https://hostel-hub-ten.vercel.app"
